# Copy to .env and fill in. .env is gitignored; never commit real keys.
#   cp .env.example .env

# --- the web page (public key is meant to ship in a browser, it is not a secret)
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=

# --- outbound calls, python -m agent.place_call +46701234567
VAPI_API_KEY=              # PRIVATE key. Secret.
VAPI_PHONE_NUMBER_ID=      # the imported Twilio number, from the Vapi dashboard

# --- optional: shared secret on the tool webhook.
# Set the same value in Vapi as the x-vapi-secret header.
VAPI_SECRET=

# --- NAS deploy: Cloudflare tunnel token (dashboard -> Zero Trust -> Networks -> Tunnels)
TUNNEL_TOKEN=

# --- public URL Vapi sends webhooks to (quick-tunnel URLs rotate on restart)
PUBLIC_HOST=

# --- review link: unlocks /?k=... Defaults to VAPI_SECRET; set it separately so a
# shareable link never carries your webhook auth.
REVIEW_KEY=
