# cp .env.example .env and fill in. Never commit real keys.

# Web page (the public key ships in the browser)
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=

# Outbound calls: python -m agent.place_call +46701234567
VAPI_API_KEY=              # private key, secret
VAPI_PHONE_NUMBER_ID=      # imported Twilio number

# Optional shared secret, sent by Vapi as x-vapi-secret
VAPI_SECRET=

# Named Cloudflare tunnel only
TUNNEL_TOKEN=

# Public webhook URL (quick-tunnel URLs rotate on restart)
PUBLIC_HOST=

# Unlocks the review at /?k=...; empty disables it (/dashboard still works)
REVIEW_KEY=
